{% extends '@Contao/page/layout.html.twig' %}

{#
    Twig layout of the Nordwerk themes ("Layout-Typ: Modern", template "nw_theme").
    The slots header, main and footer take the modules of the layout, e.g. "Shop: Kopfzeile"
    in header. For every layout of a Nordwerk theme the theme base adds stylesheets, design
    variables and body classes; this template adds the wrapper elements base.css expects.
    In a theme that is not a Nordwerk theme it is a plain layout without theme styles.
#}

{% block viewport %}
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
{% endblock %}

{% block body_content %}
    <div id="wrapper">
        {% slot header %}
            <header id="header"><div class="inside">{{ slot() }}</div></header>
        {% endslot %}

        <div id="container">
            {% slot main %}
                <main id="main"><div class="inside">{{ slot() }}</div></main>
            {% endslot %}
        </div>

        {% slot footer %}
            <footer id="footer"><div class="inside">{{ slot() }}</div></footer>
        {% endslot %}
    </div>
{% endblock %}
