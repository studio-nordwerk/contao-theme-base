<?php // Like nav_default, but the current page stays a link, marked with aria-current. ?>
<ul class="<?= $this->level ?>">
  <?php foreach ($this->items as $item): ?>
    <li<?php if ($item['class']): ?> class="<?= $item['class'] ?>"<?php endif; ?>><a href="<?= $item['href'] ?>"<?php if ($item['class']): ?> class="<?= $item['class'] ?>"<?php endif; ?><?php if ($item['isActive']): ?> aria-current="page"<?php endif; ?><?php if ('' !== $item['accesskey']): ?> accesskey="<?= $item['accesskey'] ?>"<?php endif; ?><?= $item['target'] ?><?= $item['rel'] ?? '' ?>><?= $item['link'] ?></a><?= $item['subitems'] ?? '' ?></li>
  <?php endforeach; ?>
</ul>
