{% extends '@Contao/frontend_module/_base.html.twig' %}
{# Contents come from the module (free text, headings, two navigation modules, demo note) and the shop or seminar settings. #}
{% block content %}
    <div class="nw-footer">
        <div>
            <h2>{{ brand }}</h2>
            {% block contact %}{% endblock %}
            {% if footer.text|default('') %}<div class="nw-footer__text">{{ footer.text|sanitize_html('contao')|insert_tag_raw }}</div>{% endif %}
        </div>
        {% block footer_navigation %}{% endblock %}
        {% if footer.demoNote|default(false) %}<p class="nw-demo-note">{% block demo_note %}{{ 'nw_theme.footer.demo_note'|trans }}{% endblock %}</p>{% endif %}
    </div>
{% endblock %}
