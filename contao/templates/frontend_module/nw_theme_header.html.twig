{% extends '@Contao/frontend_module/_base.html.twig' %}
{# Theme header. design.headerStyle: clear (brand left, menu centered), centered (menu left, brand centered)
   or floating (a rounded bar). Child templates fill the blocks navigation and actions. #}
{% block content %}
    <style nonce="{{ csp_nonce('style-src') }}">.nw-theme { --nw-accent: {{ design.accent }}; --nw-accent-contrast: {{ design.accentText }}; --nw-surface: {{ design.surface }}; {% if design.surfaceTextOverride %}--theme-surface-ink: {{ design.surfaceTextOverride }}; {% endif %}--theme-heading-font: '{{ headingFont }}'; --theme-body-font: '{{ bodyFont }}'; {% for variable, value in design.cssVariables %}{{ variable }}: {{ value }}; {% endfor %} }</style>
    <a class="nw-skip" href="#main">Zum Inhalt</a>
    {% block announcement %}{% if design.announcement|default('') %}<div class="nw-announce"><p>{{ design.announcement }}</p></div>{% endif %}{% endblock %}
    <div class="nw-header nw-header--{{ design.headerStyle|default('clear') }}">
        {% block brand %}
            {# A wordmark from the theme name: with three or more words the first one leads, the rest is the byline. #}
            {% set words = brand|split(' ') %}
            <a class="nw-brand" href="{{ start|default('/') }}" aria-label="{{ brand }}, Startseite">{% if logoPath %}<img src="{{ asset(logoPath) }}" alt="{{ brand }}" width="180" height="64">{% elseif words|length > 2 %}<b>{{ words|first }}</b><small>{{ words|slice(1)|join(' ') }}</small>{% else %}<b>{{ brand }}</b>{% endif %}</a>
        {% endblock %}
        {% block navigation %}{% endblock %}
        {% block actions %}{% endblock %}
    </div>
{% endblock %}
