{# Style preview for visitors (theme field "Stil-Vorschau für Besucher"): one rule per palette, typeset and shape, active while <html data-nw-palette|typeset|shape> names it; the three rules share no variable and combine freely. A style adds its spacing (no shape carries it) and, where it shows a curated axis made from its own block, that block's exact values. The script sets the attributes before the page paints, from ?stil=, ?farbe=, ?schrift=, ?form= or the last choice. Values are raw for the same reason as in _nw_design_variables. #}
<style nonce="{{ csp_nonce('style-src') }}">{% for axis, options in rules %}{% for id, variables in options %}html[data-nw-{{ axis }}="{{ id }}"] .nw-theme { {% for variable, value in variables %}{{ variable }}: {{ value|raw }}; {% endfor %}} {% endfor %}{% endfor %}{% for id, variables in spaces %}html[data-nw-style="{{ id }}"] .nw-theme { {% for variable, value in variables %}{{ variable }}: {{ value|raw }}; {% endfor %}} {% endfor %}{% for rule in own %}html[data-nw-style="{{ rule.style }}"][data-nw-{{ rule.axis }}="{{ rule.id }}"] .nw-theme { {% for variable, value in rule.variables %}{{ variable }}: {{ value|raw }}; {% endfor %}} {% endfor %}{% for id, swatch in swatches %}.nw-style-preview [data-nw-swatch="{{ id }}"] { --nw-swatch-surface: {{ swatch.surface }}; --nw-swatch-ink: {{ swatch.ink }}; --nw-swatch-action: {{ swatch.action }}; } {% endfor %}{% for id, font in fonts %}.nw-style-preview [data-nw-font="{{ id }}"] { font-family: {{ font|raw }}; } {% endfor %}{% for id, radius in radii %}.nw-style-preview [data-nw-radius="{{ id }}"] { border-radius: {{ radius|raw }}; } {% endfor %}</style>
<script nonce="{{ csp_nonce('script-src') }}">(function(){var d={{ {styles: axes, same: same, names: names, palette: rules.palette|keys, typeset: rules.typeset|keys, shape: rules.shape|keys}|json_encode|raw }},k='nw-style',q,s=null,h=document.documentElement,a=['palette','typeset','shape'],p={palette:'farbe',typeset:'schrift',shape:'form'};function v(x,i){if(typeof i!=='string')return'';var t=d.styles[i];if(d[x].indexOf(i)<0)i=t?t[a.indexOf(x)]:'';return d.same[x][i]||i}function from(id){var t=d.styles[id];return t?{style:id,palette:t[0],typeset:t[1],shape:t[2]}:{}}try{q=new URLSearchParams(location.search)}catch(e){q=null}if(q&&(q.has('stil')||q.has('farbe')||q.has('schrift')||q.has('form'))){s=from(q.get('stil'));a.forEach(function(x){var i=v(x,q.get(p[x]));if(i)s[x]=i});try{a.some(function(x){return s[x]})?localStorage.setItem(k,JSON.stringify(s)):localStorage.removeItem(k)}catch(e){}}else{try{var r=localStorage.getItem(k);if(r){s=d.styles[r]?from(r):JSON.parse(r)}}catch(e){s=null}}if(s){a.forEach(function(x){var i=v(x,s[x]);if(i)h.setAttribute('data-nw-'+x,i)});if(s.style&&d.styles[s.style])h.setAttribute('data-nw-style',s.style)}window.nwStylePreview=d})();</script>
