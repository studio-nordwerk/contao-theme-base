{# Values of the theme form (Layout → Themes → Gestaltung) as CSS variables. Loaded in the <head> of every page with a layout of the theme. #}
<style nonce="{{ csp_nonce('style-src') }}">.nw-theme { --nw-accent: {{ design.accent }}; --nw-accent-contrast: {{ design.accentText }}; --nw-surface: {{ design.surface }}; {% if design.surfaceTextOverride %}--theme-surface-ink: {{ design.surfaceTextOverride }}; {% endif %}--theme-heading-font: '{{ headingFont }}'; --theme-body-font: '{{ bodyFont }}'; {% for variable, value in design.cssVariables %}{{ variable }}: {{ value }}; {% endfor %} }</style>
