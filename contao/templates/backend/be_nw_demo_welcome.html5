<?php $escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); $lang = $this->lang; ?>
<section class="nw-demo-welcome" aria-labelledby="nw-demo-welcome-title">
<h2 class="sub_headline" id="nw-demo-welcome-title"><?= $escape($lang['title']) ?></h2>
<p class="tl_help"><?= $escape(sprintf($lang['intro'], $this->product)) ?></p>
<form class="tl_form" method="post" action="<?= $escape($this->action) ?>">
<input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>"><input type="hidden" name="themeAction" value="import-demo"><input type="hidden" name="origin" value="welcome">
<div class="tl_formbody_edit"><div class="widget">
<h3><?= $escape($lang['with']) ?></h3>
<p><?= $escape($lang['withText']) ?></p>
<ul class="tl_listing_text"><?php foreach ($this->contents as $item): ?><li>– <?= $escape($item) ?></li><?php endforeach; ?></ul>
<p class="tl_help"><?= $escape($lang['fictional']) ?></p>
</div></div>
<div class="tl_formbody_submit"><button class="tl_submit" type="submit"><?= $escape($lang['withButton']) ?></button></div>
</form>
<form class="tl_form" method="post" action="<?= $escape($this->action) ?>">
<input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>"><input type="hidden" name="themeAction" value="decline-demo">
<div class="tl_formbody_edit"><div class="widget">
<h3><?= $escape($lang['without']) ?></h3>
<p><?= $escape($lang['withoutText']) ?></p>
</div></div>
<div class="tl_formbody_submit"><button class="tl_submit" type="submit"><?= $escape($lang['withoutButton']) ?></button></div>
</form>
</section>
