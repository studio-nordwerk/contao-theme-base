<?php $escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); ?>
<h2 class="sub_headline">Gestaltung</h2>
<p class="tl_info">Logo, Farben und lokal ausgelieferte Schriften pflegen Sie unter Layout → Themes → Theme bearbeiten, im Bereich Gestaltung.</p>
<?php if (!$this->themes): ?>
<p>Bitte legen Sie zuerst Demo-Seiten oder ein Theme für dieses Theme-Paket an.</p>
<?php endif; ?>
<?php foreach ($this->themes as $theme): ?>
<h3><?= $escape($theme['name']) ?></h3>
<dl><?php foreach ($theme['values'] as $label => $value): ?><dt><?= $escape($label) ?></dt><dd><?= $escape($value) ?></dd><?php endforeach; ?></dl>
<p><a class="tl_submit" href="<?= $escape($theme['editUrl']) ?>">Gestaltung im Theme bearbeiten</a></p>
<?php endforeach; ?>
