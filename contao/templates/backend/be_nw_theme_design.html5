<?php
$escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
?>
<h2 class="sub_headline">Gestaltung</h2>
<p class="tl_info">Logo, Farben und Schrift für Ihr Theme. Schriften werden lokal ausgeliefert.</p>
<?php if ($this->notice): ?><p class="tl_confirm" role="status"><?= $escape($this->notice) ?></p><?php endif; ?>
<?php if ($this->error): ?><p class="tl_error" role="alert"><?= $escape($this->error) ?></p><?php endif; ?>
<?php if (!$this->themes): ?><p>Bitte legen Sie zuerst Demo-Seiten oder ein Theme an.</p><?php else: ?>
<form method="get" action="contao" class="tl_form"><input type="hidden" name="do" value="nw_theme_design"><label for="theme-selector">Theme</label><select name="theme" id="theme-selector" class="tl_select"><?php foreach ($this->themes as $theme): ?><option value="<?= $escape($theme['id']) ?>" <?= (int) $theme['id'] === $this->themeId ? 'selected' : '' ?>><?= $escape($theme['name']) ?></option><?php endforeach; ?></select><button class="tl_submit">Theme wählen</button></form>
<form method="post" action="<?= $escape($this->actionUrl) ?>" class="tl_form tl_edit_form">
<input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>"><input type="hidden" name="themeAction" value="save-design">
<div class="tl_formbody_edit"><fieldset class="tl_tbox"><legend>Gestaltung</legend>
<div class="widget"><h3><label for="nw-logo">Logo (Dateiauswahl)</label></h3><select class="tl_select" name="logo" id="nw-logo"><option value="">Theme-Name als Wortmarke</option><?php foreach ($this->files as $file): ?><option value="<?= $escape(bin2hex($file['uuid'])) ?>" <?= $this->settings->logo === $file['uuid'] ? 'selected' : '' ?>><?= $escape($file['path']) ?></option><?php endforeach; ?></select><p class="tl_help">Bilder zuerst in der Dateiverwaltung hochladen und öffentlich freigeben. Alternativ: native Dateiauswahl unter Themes → Theme bearbeiten.</p></div>
<?php foreach (['accent' => ['Akzentfarbe', $this->settings->accent], 'surface' => ['Flächenfarbe', $this->settings->surface]] as $field => [$label, $value]): ?><div class="widget w50"><h3><label for="nw-<?= $field ?>"><?= $label ?></label></h3><input class="tl_text" id="nw-<?= $field ?>" name="<?= $field ?>" value="<?= $escape($value) ?>" pattern="#[0-9a-fA-F]{6}" maxlength="7" required><p class="tl_help">Format: #RRGGBB</p></div><?php endforeach; ?>
<div class="widget w50 clr"><h3><label for="nw-font">Schriftpaar</label></h3><select name="fontPair" id="nw-font" class="tl_select"><?php foreach ($this->fontPairs as $key => $pair): ?><option value="<?= $escape($key) ?>" <?= $key === $this->settings->fontPair ? 'selected' : '' ?>><?= $escape(implode(' / ', array_unique($pair))) ?></option><?php endforeach; ?></select></div>
<div class="widget w50"><h3><label for="nw-header-style">Kopfzeile</label></h3><select name="headerStyle" id="nw-header-style" class="tl_select"><?php foreach ($this->headerStyles as $key => $label): ?><option value="<?= $escape($key) ?>" <?= $key === $this->settings->headerStyle ? 'selected' : '' ?>><?= $escape($label) ?></option><?php endforeach; ?></select></div>
<div class="widget clr"><h3><label for="nw-announcement">Hinweisleiste (optional)</label></h3><input class="tl_text" id="nw-announcement" name="announcement" value="<?= $escape($this->settings->announcement) ?>" maxlength="120"><p class="tl_help">Eine Zeile über dem Kopf, zum Beispiel „Versandkostenfrei ab 30 €“. Leer lassen, um sie auszublenden.</p></div>
</fieldset></div><div class="tl_formbody_submit"><button class="tl_submit" type="submit">Gestaltung speichern</button> <a class="tl_submit" href="<?= $escape($this->previewUrl) ?>" target="_blank" rel="noopener">Seite ansehen</a></div>
</form>
<?php if ($this->settings->contrast() < 4.5): ?><p class="tl_error" role="alert">Weißer Text auf Ihrer Akzentfarbe erreicht nur <?= $escape(number_format($this->settings->contrast(), 2, ',', '')) ?>:1 (mindestens 4,5:1). Das Theme verwendet deshalb dunklen Buttontext. Prüfen Sie eigene CSS-Anpassungen.</p><?php endif; ?>
<?php endif; ?>
