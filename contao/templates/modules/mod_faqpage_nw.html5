<?php $this->extend('block_unsearchable'); ?>

<?php $this->block('content'); ?>

  <?php // FAQ as an accordion: one question per row, the answer opens below. The FAQPage data stays below. ?>
  <?php foreach ($this->faq as $category): ?>
    <div class="nw-faq">
      <?php if ($category['headline']): ?><h2><?= $category['headline'] ?></h2><?php endif; ?>
      <?php foreach ($category['items'] as $faq): ?>
        <details class="nw-faq__item" id="<?= $faq->alias ?>">
          <summary><?= $faq->question ?></summary>
          <div class="nw-faq__answer"><?= $this->cspInlineStyles($faq->answer) ?></div>
        </details>
      <?php endforeach; ?>
    </div>
  <?php endforeach; ?>

<?php $this->endblock(); ?>

<?php

$this->addSchemaOrg($this->getSchemaOrgData());
